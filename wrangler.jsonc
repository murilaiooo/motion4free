// Hospedagem na Cloudflare (Workers com arquivos estáticos). O site é o build do Vite em ./dist.
// worker/index.ts só atende /hf/*, /cdn/* e /gh/*: espelho dos modelos (transcrição e IA opcional) no próprio site (ADR-0006, ADR-0009).
{
  "name": "motion4free",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/hf/*", "/cdn/*", "/gh/*"]
  },
  // Prévia por PR (`wrangler preview`, usado pela Cloudflare nas branches que não são a main) exige este bloco,
  // mesmo vazio; sem ele a prévia falhava em todo PR desde o #33. A publicação da main não muda.
  "previews": {}
}
